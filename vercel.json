{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-blog-post",
      "schedule": "0 10 */4 * *"
    },
    {
      "path": "/api/cron/generate-blog-social-video",
      "schedule": "30 10 */4 * *"
    }
  ]
}
